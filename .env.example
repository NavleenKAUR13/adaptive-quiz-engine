# Copy this file to ".env" and fill in real values. NEVER commit ".env".
PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include a database name, e.g. /quizzy
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/quizzy?retryWrites=true&w=majority
# Long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h
# Comma-separated origins allowed to call the API from a different origin (e.g. VS Code Live Server).
# Not needed when you open the app through the Express server at http://localhost:5000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
BCRYPT_ROUNDS=10
# Only used by `npm run create-teacher` (read once, never stored in plaintext):
TEACHER_NAME=Teacher
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=change-me-before-running
